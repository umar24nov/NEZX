# Leave empty in local development: Vite proxies /api to http://localhost:4000.
# In production set this to the API origin, e.g. https://api.nezxacademy.com
VITE_API_URL=

# Public site origin, used for canonical + social URLs at build time.
VITE_SITE_URL=http://localhost:5173

# Cloudflare Turnstile site key. Leave empty to hide the widget locally.
VITE_TURNSTILE_SITE_KEY=
