# ---- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated. Add your Cloudflare Pages domain in production.
WEB_ORIGINS=http://localhost:5173
# Render / Cloudflare terminate TLS in front of the API. Use 1 in production.
TRUST_PROXY=0

# ---- Database -------------------------------------------------------------
# Local Docker: docker compose up -d
DATABASE_URL="postgresql://nezx:nezx@localhost:5432/nezx?schema=public"

# ---- Auth (Better Auth) ---------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-a-32-character-random-string"
BETTER_AUTH_URL=http://localhost:4000
# Used by `npm run db:seed` to create / promote the owner account.
ADMIN_EMAIL=owner@nezxacademy.com
ADMIN_PASSWORD=ChangeMe-12345

# ---- Cloudflare Turnstile -------------------------------------------------
# Leave blank in local development; the API then skips verification.
TURNSTILE_SECRET_KEY=

# ---- Cloudflare R2 (private bucket + public custom domain) ----------------
# Leave blank if you are not uploading media yet. Presigned uploads return 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nezx-media
R2_PUBLIC_BASE_URL=https://media.example.com
